{"data":{"body":"**P1:** The standalone extra still supports OpenTelemetry 1.20, whose `TraceFlags` lacks `.sampled`. Every fallback invocation on that supported version raises `AttributeError` here, leaving telemetry missing or fragmented. Use the version-compatible `TraceFlags.SAMPLED` bitmask check and add minimum-version coverage.","comment_node_id":"PRRC_kwDOPsIIsM79_qb1","finding_digest":"09123a9d23a9f32ac9886f8e6c1eee7b22d6cc0defbfe2c337f6ade27ab72936","finding_id":"arf_v1_bejdvhjdvhzsvsmin6hgyhxopm","finding_key":"otel/execution_root.py::executionroot.export::minimum-otel-traceflags-compatibility","identity_key":"otel/execution_root.py::executionroot.export::minimum-otel-traceflags-compatibility","line":43,"observation_digest":"7388dee187b1bcb272bdcc02635b176aad6d362656719010a9ddadb30d614c0c","observation_id":"aro_v1_ooen5ymhwg6le4v5zqbggwyxnk","path":"packages/aws-durable-execution-sdk-python-otel/src/aws_durable_execution_sdk_python_otel/execution_root.py","prior_finding_id":"arf_v1_bejdvhjdvhzsvsmin6hgyhxopm","published_at":"2026-10-13T16:33:12Z","review_id":"arr_v1_ynzgkfhwcosecvegk3x3ac6f72","reviewed_base_sha":"14923aacf50e705b079bc321e38bc2cc6bfd47a5","reviewed_head_sha":"e3c2d419814b35e26c9ff7575b9db236a1c762aa","reviewer":"codex","start_line":43,"suggestion_id":""},"pull_request":{"number":754},"record_id":"art_v1_c3dhecz47hg75jzcybxh5jr7ap","record_type":"finding_observed","recorded_at":"2026-10-13T16:33:12Z","repository":{"full_name":"aws/aws-durable-execution-sdk-python","id":1052903600},"schema_version":1}
