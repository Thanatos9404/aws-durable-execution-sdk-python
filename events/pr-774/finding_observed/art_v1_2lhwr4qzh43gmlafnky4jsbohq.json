{"data":{"body":"**P1:** This permits an unknown string inside `OperationUpdate`, but the current core serializers still call `sub_type.value`. The real checkpoint path consequently fails while persisting to file/SQLite or while serializing the in-memory response\u2014after the execution and checkpoint token have already been mutated. Keep this parser enum-only until core supports strings end to end, or update every operation/update persistence and response boundary and add an endpoint/store round-trip test.","comment_node_id":"PRRC_kwDOPsIIsM7-QTwf","finding_digest":"bcdc3bdaf9c10e5dad5ea39231a3072f6d6436dd1b1750008fd44bb3281f9035","finding_id":"arf_v1_xtodxwxzyehf3lk6uojddiyhf5","finding_key":"testing/model.py::checkpointdurableexecutionrequest.from_dict::string-subtype-serialization","identity_key":"testing/model.py::checkpointdurableexecutionrequest.from_dict::string-subtype-serialization","line":3191,"observation_digest":"ceae8b25507eb6fa04d1cb94ab7b3fcde4b1c181f58674f00f8c4a65f9e713ad","observation_id":"aro_v1_z2xiwjkqp23pubgrzokkw6z7zx","path":"packages/aws-durable-execution-sdk-python-testing/src/aws_durable_execution_sdk_python_testing/model.py","prior_finding_id":"","published_at":"2026-10-14T01:00:26Z","review_id":"arr_v1_bahs4prlzcfowvbkas6jpsaenx","reviewed_base_sha":"0ceaf045ad42a8ea779d9c5d4c3408ce9631d04b","reviewed_head_sha":"c9c9b60a55afee3d599040f46e38ade14ebd01e1","reviewer":"codex","start_line":3188,"suggestion_id":""},"pull_request":{"number":774},"record_id":"art_v1_2lhwr4qzh43gmlafnky4jsbohq","record_type":"finding_observed","recorded_at":"2026-10-14T01:00:26Z","repository":{"full_name":"aws/aws-durable-execution-sdk-python","id":1052903600},"schema_version":1}
