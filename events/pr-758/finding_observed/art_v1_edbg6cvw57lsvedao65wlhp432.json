{"data":{"body":"[P1] Narrow the optional history fields before dereferencing them. `Event.name`, `callback_started_details`, and `callback_id` are optional, so mypy rejects this expression and the later callback calls; `result.result` is likewise optional at `json.loads`. The required type check recursively includes this test directory. Build a `dict[str, str]` after asserting these values are non-`None`, and assert the result payload before decoding it.","comment_node_id":"PRRC_kwDOPsIIsM79_OLq","finding_digest":"db2e892372268e99ec3512dd21d73fe9a1e21d2941f0c3308b7b14f664634d1b","finding_id":"arf_v1_3mxisi3se2hjt3bvclosdvz75g","finding_key":"packages/aws-durable-execution-sdk-python-otel/tests/e2e/test_parent_creation_order_int.py::test_early_sibling_callback_exports_under_real_parent_before_user_observation::optional-fields-not-narrowed","identity_key":"packages/aws-durable-execution-sdk-python-otel/tests/e2e/test_parent_creation_order_int.py::test_early_sibling_callback_exports_under_real_parent_before_user_observation::optional-fields-not-narrowed","line":128,"observation_digest":"dbd7b4ad7b503df9fec7086677bbed2348ed2d69bda0e5763d93dccf7106296c","observation_id":"aro_v1_3pl3jll3ka67t7whbbthpo7nen","path":"packages/aws-durable-execution-sdk-python-otel/tests/e2e/test_parent_creation_order_int.py","prior_finding_id":"","published_at":"2026-10-13T16:21:53Z","review_id":"arr_v1_75u3osppgznqirn3v64jdmo37k","reviewed_base_sha":"14923aacf50e705b079bc321e38bc2cc6bfd47a5","reviewed_head_sha":"79e1a263bfe1b8926848dc2c83af2f0fb4353d97","reviewer":"codex","start_line":128,"suggestion_id":""},"pull_request":{"number":758},"record_id":"art_v1_edbg6cvw57lsvedao65wlhp432","record_type":"finding_observed","recorded_at":"2026-10-13T16:21:53Z","repository":{"full_name":"aws/aws-durable-execution-sdk-python","id":1052903600},"schema_version":1}
