{"data":{"body":"[P2] Prune acknowledged IDs even when the watermark does not advance. Older persisted executions intentionally load missing sequence fields as zero and may still contain `UpdatedOperationIds`; after `_begin_invocation` stops clearing them, acknowledging sequence zero skips this block and redelivers the same terminal operations on every later invocation, duplicating plugin callbacks and spans. Move this filtering outside the `seq > handler_seen_seq` condition and add an old-format store regression.","comment_node_id":"PRRC_kwDOPsIIsM7-xltE","finding_digest":"464c63d0f0c62dce51f59a8ae4b9c5ddc7c1207d3542e3ccf892c800be36444e","finding_id":"arf_v1_izgghuhqyyw44upvtkfojoof3x","finding_key":"testing/execution.py::operationpaginatorstate.advance_handler_seen::equal-watermark-update-redelivery","identity_key":"testing/execution.py::operationpaginatorstate.advance_handler_seen::equal-watermark-update-redelivery","line":891,"observation_digest":"fda9023bdfdae4860feb6f3ca3493f8dea43329d23d563d16c491967387049c2","observation_id":"aro_v1_7wuqeo673lsimd7ln46kgsj7rx","path":"packages/aws-durable-execution-sdk-python-testing/src/aws_durable_execution_sdk_python_testing/execution.py","prior_finding_id":"","published_at":"2026-10-14T18:01:26Z","review_id":"arr_v1_oewy5k5a56puqauwzfq7cp4ldm","reviewed_base_sha":"0ceaf045ad42a8ea779d9c5d4c3408ce9631d04b","reviewed_head_sha":"4b8d6a40c7e4c4bc133e267647716ba812720e25","reviewer":"codex","start_line":885,"suggestion_id":""},"pull_request":{"number":758},"record_id":"art_v1_xewqiq3qzaf5wsiejn2mzsep4v","record_type":"finding_observed","recorded_at":"2026-10-14T18:01:26Z","repository":{"full_name":"aws/aws-durable-execution-sdk-python","id":1052903600},"schema_version":1}
